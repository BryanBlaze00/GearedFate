      propertyPath: '_dialogueLines.Array.data[0]'
      value: "They were right\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1584971533550513579, guid: 3b5583c86f8f2584d88cffb77000dd09, type: 3}
      propertyPath: '_dialogueLines.Array.data[1]'
      value: All those innovations only led to a dead end. I lost everything.
      objectReference: {fileID: 0}
    - target: {fileID: 1584971533550513579, guid: 3b5583c86f8f2584d88cffb77000dd09, type: 3}
      propertyPath: '_dialogueLines.Array.data[2]'
      value: "My dear creation\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1584971533550513579, guid: 3b5583c86f8f2584d88cffb77000dd09, type: 3}
      propertyPath: '_dialogueLines.Array.data[3]'
      value: Please accept this gift. My heaviest burden.
      objectReference: {fileID: 0}
    - target: {fileID: 1584971533550513579, guid: 3b5583c86f8f2584d88cffb77000dd09, type: 3}
      propertyPath: '_dialogueLines.Array.data[4]'
